# Crea un proyecto en https://supabase.com y copia estos valores desde
# Project Settings > API. NEXT_PUBLIC_* se expone al navegador; el resto no.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para scripts/ingest-*.ts (fase 2+), nunca en código de cliente.
SUPABASE_SERVICE_ROLE_KEY=
